        <mxCell id="static" value="&lt;b&gt;Vercel 정적 화면&lt;/b&gt;&lt;br&gt;index.html · /aleph.json&lt;br&gt;nosniff · 공개 data.json 제외" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4fb;strokeColor=#93b2ce;fontColor=#203147;fontFamily=Malgun Gothic;fontSize=16;spacing=12;arcSize=8;" vertex="1" parent="1">
