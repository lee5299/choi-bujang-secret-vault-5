{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/operations-room", "destination": "/api/operations-summary" },
    { "source": "/api/operations-public", "destination": "/api/operations-summary" },
    { "source": "/api/notes/:id/restore", "destination": "/api/note-restore" },
    { "source": "/api/notes/:id", "destination": "/api/notes/[id]" },
    { "source": "/api/announcements/:id", "destination": "/api/announcements/[id]" }
  ]
}
